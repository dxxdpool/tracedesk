# Copy to .env and change the values. Never commit .env.

# Postgres (docker compose, host port 5433)
POSTGRES_USER=tracedesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracedesk
DATABASE_URL=postgresql+asyncpg://tracedesk:change-me@localhost:5433/tracedesk

# Bearer tokens (demo-grade auth), one per role, all different, at least 16 characters.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Investigator and Skeptic
AGENT_TOKEN=change-me-agent-token
# Validator only: the one agent that may mark a hypothesis verified
VALIDATOR_TOKEN=change-me-validator-token
# The human only: approvals and human-role transitions
APPROVER_TOKEN=change-me-approver-token

# Used by the `st` CLI (each agent and the human set their own token and name)
TRACEDESK_API=http://localhost:8000

# 1 allows local repo paths under eval/cases/ (eval and dev only)
ALLOW_LOCAL_REPOS=0

# Absolute path of this repo's workspaces/ folder on the host (compose needs it to print where
# agents find each clone), e.g. C:/Users/you/tracedesk/workspaces or /home/you/tracedesk/workspaces
WORKSPACES_HOST_DIR=/absolute/path/to/tracedesk/workspaces
