# Copy to .env and change the values. Never commit .env.

# Postgres (docker compose, host port 5433)
POSTGRES_USER=tracedesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracedesk
DATABASE_URL=postgresql+asyncpg://tracedesk:change-me@localhost:5433/tracedesk

# Bearer tokens (demo-grade auth). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=change-me-agent
APPROVER_TOKEN=change-me-approver

# 1 allows local repo paths under eval/cases/ (eval and dev only)
ALLOW_LOCAL_REPOS=0
